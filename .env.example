# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าเอง (ห้าม commit ไฟล์ .env)
#   cp .env.example .env

# --- PostgreSQL (ใช้ทั้งเป็น metadata DB ของ Airflow และ DB เก็บข้อมูลหนังสือ) ---
POSTGRES_USER=bookuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=books
POSTGRES_PORT=5433

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_SECRET_KEY=change_me_to_a_random_string
AIRFLOW_PORT=8080

# --- Web dashboard ---
WEB_PORT=8501

# --- Scraper ---
# ใส่ชื่อ/อีเมลติดต่อจริงของคุณ เพื่อให้เว็บปลายทางติดต่อได้หากมีปัญหา
SCRAPER_USER_AGENT=KU-KPS-02739452-StudentBot/1.0 (course project; contact: your_email@example.com)
REQUEST_DELAY_SECONDS=1.5
MAX_PRODUCTS_PER_SOURCE=200
MAX_FETCHES_PER_SOURCE=400

# --- Data quality gate ---
QUALITY_MAX_INVALID_RATIO=0.25
QUALITY_MIN_ROWS=20
